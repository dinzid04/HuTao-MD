{
  "name": "hutao-md",
  "version": "1.6.0",
  "description": "HuTao - MD Multi-Device WhatsApp Bot",
  "main": "index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node index.js --pairing-code",
    "start:termux": "bash termux-start.sh",
    "prestart": "node -e \"const fs=require('fs'),cp=require('child_process');const pkg=JSON.parse(fs.readFileSync('package.json','utf8'));const miss=Object.keys(pkg.dependencies||{}).filter(m=>{try{require.resolve(m);return false;}catch{return true;}});if(miss.length){console.log('[Prestart] Modul belum lengkap ('+miss.join(', ')+'), menjalankan npm install...');cp.execSync('npm install --allow-git=all --no-audit --no-fund --fetch-retries=5',{stdio:'inherit'});}\"",
    "install-deps": "npm install --allow-git=all --no-audit --no-fund --fetch-retries=5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "baileys",
    "whiskeysockets/baileys",
    "hutao-md",
    "multi-device",
    "whatsapp-bot"
  ],
  "author": "DinzID",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.0",
    "@whiskeysockets/baileys": "https://github.com/dinzid04/hutao-baileys.git",
    "awesome-phonenumber": "^4.4.0",
    "axios": "^1.19.0",
    "big-integer": "^1.6.52",
    "chalk": "^4.1.2",
    "cheerio": "^1.0.0-rc.12",
    "figlet": "^1.12.0",
    "file-type": "^16.5.4",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.4",
    "js-confuser": "^2.1.3",
    "libsignal": "https://github.com/alifalfrl/libsignal-node.git",
    "moment-timezone": "^0.5.43",
    "mongodb": "^6.12.0",
    "node-cache": "^5.1.2",
    "node-webpmux": "^3.1.7",
    "pino": "^9.4.1",
    "typescript": "5.7.3",
    "yt-search": "^2.13.1"
  },
  "optionalDependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "canvas": "^3.2.3",
    "sharp": "^0.32.6"
  },
  "overrides": {
    "libsignal": "https://github.com/alifalfrl/libsignal-node.git"
  },
  "allowScripts": {
    "@ffmpeg-installer/linux-ia32@4.1.0": true,
    "@ffmpeg-installer/linux-x64@4.1.0": true,
    "canvas@3.2.3": true,
    "protobufjs@6.8.8": true,
    "protobufjs@7.6.6": true,
    "sharp@0.32.6": true
  }
}
